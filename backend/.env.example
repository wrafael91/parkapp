# PostgreSQL (docker-compose)
POSTGRES_USER=parkapp
POSTGRES_PASSWORD=change_me
POSTGRES_DB=parkapp_dev

# Prisma
DATABASE_URL="postgresql://parkapp:change_me@localhost:5432/parkapp_dev?schema=public"

PORT=3000

# Origin allowed to send requests that change data (CSRF protection).
# Production uses https://rolopark.com by default; locally, the Vite dev server.
APP_ORIGIN=http://localhost:5173
